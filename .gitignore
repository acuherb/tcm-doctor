*_hash_backup.txt

# ---- Node / 前端构建 ----
node_modules/
dist/
dist-electron/
release/
*.local

# ---- 打包产物（PyInstaller 后端可执行文件，勿入库）----
backend/dist/
backend/build/
*.spec.bak
tcm-backend
tcm-backend.exe

# ---- 环境变量 / 密钥 ----
.env
.env.*
.signing_key

# IDE/助手本地数据（含会话记录，不入库）
.codebuddy/

# ---- 日志 / 编辑器 ----
*.log
.vscode/
.idea/
.DS_Store

# 构建导出的镜像 tar（部署用，不入库）
tcm-doctor-image.tar

# ---- 内容数据模板（不入库：用户按倪海厦人纪调整后作为模板导入，默认纯框架）----
# 这些 JSON 仍可随发行包/本地存在，作为「内置模板」在设置页一键导入；但源码仓库不追踪，避免大体积临床数据入库与版权风险。
backend/app/data/*.json
backend/app/data/books/*.json
# 发布包构建产物（Release 资产，由 scripts/build_release.py 生成，勿入库）
templates/releases/

